{
  "name": "nudge",
  "version": "0.1.0",
  "private": true,
  "description": "Nudge: a personal follow-up agent that keeps reminding you until things are done. Built on Cloudflare Agents + Workers AI.",
  "keywords": [
    "agents",
    "ai",
    "cloudflare",
    "durable-objects",
    "reminders",
    "workers-ai"
  ],
  "license": "MIT",
  "author": "Dev Bathani",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:offline": "NUDGE_OFFLINE=1 vite dev",
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt --write .",
    "lint": "oxlint src/ test/",
    "check": "oxfmt --check . && oxlint src/ test/ && tsc --noEmit && vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "0.9.3",
    "@cloudflare/kumo": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "^0.17.4",
    "ai": "^6.0.197",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "workers-ai-provider": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "~5.0.3",
    "wrangler": "^4.113.0"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
